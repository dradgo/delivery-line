<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.dradgo</groupId>
		<artifactId>deliveryline</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>deliveryline-backend</artifactId>
	<packaging>jar</packaging>
	<name>deliveryline-backend</name>

	<!-- Story 2.32 — JaCoCo coverage gate properties.
	     jacoco.check.skip: the jacoco-check execution binds its <skip> to this
	     property; the foundation-gate profile below overrides it to true so the
	     aggregator subset job does not gate on non-representative coverage.
	     jacoco.merged.exec: single source of truth for the merged exec file
	     path, referenced by the merge <destFile> and the report/check
	     <dataFile> so the three stay in lockstep (a typo in one literal would
	     otherwise silently decouple the merge from the gate). -->
	<properties>
		<jacoco.check.skip>false</jacoco.check.skip>
		<jacoco.merged.exec>${project.build.directory}/jacoco-merged.exec</jacoco.merged.exec>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.dradgo</groupId>
			<artifactId>deliveryline-runner-contracts</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
			Story 2.1 — Build-order dependency on the Vite SPA bundle.

			The frontend module is <packaging>pom</packaging> with no Java classes; this
			<dependency type=pom> contributes nothing to the backend classpath, but it
			forces Maven's reactor to build deliveryline-frontend BEFORE this module so
			the maven-resources-plugin step below finds ../deliveryline-frontend/target/dist/
			populated. The root POM declares <modules> in the order [backend, frontend,
			runner-contracts]; without this <dependency> Maven would attempt backend first
			and the AR32 enforcer (below) would always fail under reactor builds.
		-->
		<dependency>
			<groupId>org.dradgo</groupId>
			<artifactId>deliveryline-frontend</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
			<!-- scope=test: this dep exists solely to coerce reactor build order
			     (frontend module before backend) so the maven-resources-plugin step
			     below finds target/dist/ populated. Using scope=test keeps the
			     edge out of the published backend POM's runtime/compile dependency
			     graph — analyzers, IDEs, and downstream BOM consumers won't see a
			     phantom dependency on a packaging=pom module that ships no artifact. -->
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Story 3.19 (AC5) — Prometheus registry so /actuator/prometheus exists (Actuator alone
		     falls back to an in-memory SimpleMeterRegistry with no scrape endpoint). No version: the
		     Spring Boot 4.0.6 BOM manages it. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.shell</groupId>
			<artifactId>spring-shell-starter</artifactId>
		</dependency>
		<!--
			Story 6.9 — springdoc-openapi for the localhost REST read surface.
			The 3.0.x line targets Spring Boot 4 / Spring Framework 7 (the 2.8.x line is
			Boot 3 only — verified against repo1.maven.org metadata, not the cached Central
			search index). Serves /v3/api-docs (JSON) + /swagger-ui.html and drives the
			committed openapi.json snapshot consumed by story 2.6's generated TS client.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			Story 3.1 — Docker client for the runners.docker-profile-gated DockerRunnerAdapter.
			Pinned explicitly in compile scope here (rather than relying on Testcontainers'
			transitive copy at test scope) because the adapter runs in production. Story 3.1
			trap T8: all com.github.dockerjava.* types stay behind DockerEngineGateway —
			ArchUnit rule ADAPTERS_RUNNER_DOCKER_TYPES_STAY_BEHIND_GATEWAY pins this.
		-->
		<dependency>
			<groupId>com.github.docker-java</groupId>
			<artifactId>docker-java-core</artifactId>
			<version>3.7.1</version>
		</dependency>
		<dependency>
			<groupId>com.github.docker-java</groupId>
			<artifactId>docker-java-transport-httpclient5</artifactId>
			<version>3.7.1</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<!-- Story 3.17b: the RunnerQueueListener uses the pgjdbc LISTEN/NOTIFY API
			     (org.postgresql.PGConnection#getNotifications) at compile time, so the driver is
			     compile-scoped (was runtime). It remains the only Postgres-specific compile coupling
			     and lives in the adapters.persistence layer. -->
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Story 1.23 — the JUnit Platform Launcher API is what
		     FoundationGateVerificationTest uses to delegate-run existing Epic-1
		     contract test classes by FQN. Spring Boot's test starter ships
		     junit-platform-engine but not junit-platform-launcher; the launcher
		     is normally consumed by Maven Surefire/Failsafe via the JUnit Platform
		     provider and only needs to be on the test compile/runtime classpath
		     when test code itself invokes the Launcher API. -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Story 1.23 review patch P16 — networknt JSON Schema validator drives
		     FixtureEventStreamSchemaConformanceContractTest's authoritative draft-2020-12
		     conformance check. NOT redeclared here: it arrives transitively at COMPILE
		     scope from deliveryline-runner-contracts (whose RunnerContractValidator needs
		     it at runtime). A direct <scope>test</scope> declaration would WIN over the
		     transitive compile-scope dep (Maven nearest-definition mediation) and strip the
		     library from the executable jar — breaking RunnerContractValidator bean creation
		     at boot (NoClassDefFoundError: com.networknt.schema.SpecificationVersion). The
		     transitive compile dep is on the test classpath too, so the fixture test still
		     compiles and runs. -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludeDockerCompose>false</excludeDockerCompose>
					<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
				</configuration>
			</plugin>

			<!--
				Story 2.1 — AR32 quality gate (AC3).

				Fails the backend build with a clear remediation hint if the frontend Vite
				bundle is missing. Bound to generate-resources (BEFORE the resources copy
				below in process-resources) so the error surfaces before any artifact-copy
				attempt. Under a reactor build (`mvn install` from root) the frontend
				dependency above orders the frontend module first, so dist/ is present.
				The failure mode this prevents: a developer runs
				`mvn -pl deliveryline-backend package` alone and ships a backend jar with
				no SPA.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<!-- Pin explicitly rather than relying on Spring Boot's pluginManagement
				     so the AR32 quality-gate behavior is deterministic across Spring Boot
				     parent upgrades. Bump in lock-step with Spring Boot's bundled version. -->
				<version>3.4.1</version>
				<executions>
					<execution>
						<id>require-frontend-dist</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<!-- Same skip toggle as frontend-maven-plugin (deliveryline-frontend/pom.xml).
							     Without this, `-Dfrontend-maven-plugin.skip=true` skips the frontend
							     build but the enforcer still hard-fails — breaking the documented
							     backend-only local iteration workflow. -->
							<skip>${frontend-maven-plugin.skip}</skip>
							<rules>
								<requireFilesExist>
									<files>
										<file>${maven.multiModuleProjectDirectory}/deliveryline-frontend/target/dist/index.html</file>
									</files>
									<message>Frontend dist not found at expected path deliveryline-frontend/target/dist/index.html; ensure the frontend bundle is built before packaging the backend. Fix with one of: 'mvn -pl deliveryline-frontend package' (build just the bundle) or 'mvn clean install' from the reactor root (build everything).</message>
								</requireFilesExist>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				Story 2.1 — Wipe target/classes/static/ before fresh copy (AC4).

				Bound to process-resources (BEFORE the copy execution below at prepare-package
				phase, in lifecycle order). Without this, renamed or removed Vite chunks from
				a prior build linger in BOOT-INF/classes/static/ during incremental builds
				(without `clean`), producing inconsistent jar contents that point at deleted
				bundle assets.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>wipe-static-before-copy</id>
						<phase>process-resources</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset>
									<directory>${project.build.directory}/classes/static/assets</directory>
								</fileset>
								<fileset>
									<directory>${project.build.directory}/classes/static</directory>
									<includes>
										<include>index.html</include>
										<include>favicon.svg</include>
										<include>icons.svg</include>
										<include>vite.svg</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				Story 2.1 — Copy Vite bundle into Spring Boot static resources (AC3 + AC4).

				Writes to ${project.build.directory}/classes/static/ (Spring Boot's repackage
				step copies everything under target/classes/ into BOOT-INF/classes/ in the
				executable jar). NOT writing to src/main/resources/static/ despite AC3's
				literal wording — generated content under src/ pollutes the working tree,
				breaks reproducible builds, and would be linted as source. End-state under
				BOOT-INF/classes/static/ is identical (per AC4 invariant).

				Bound to prepare-package (NOT process-resources): the default-resources
				execution also runs in process-resources and copies src/main/resources/static/
				if it ever gains files; binding to prepare-package guarantees the Vite copy
				lands after default-resources has settled, with deterministic precedence.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-frontend-dist</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<skip>${frontend-maven-plugin.skip}</skip>
							<outputDirectory>${project.build.directory}/classes/static</outputDirectory>
							<resources>
								<resource>
									<!-- ${maven.multiModuleProjectDirectory} matches the enforcer
									     above; using ${project.basedir}/../ broke on Windows during
									     story 2.1 dev (see Debug Log) and works through reactor
									     re-roots / symlinks less reliably. -->
									<directory>${maven.multiModuleProjectDirectory}/deliveryline-frontend/target/dist</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Story 1.21 — quality plugins (versions + config from root pluginManagement). -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<!-- Story 2.30 — bind `check` to verify so `mvn verify` fails on
				     unformatted source (AC1). The formatting config (Google Java
				     Format, style GOOGLE — Google's standard 2-space variant — with
				     UNIX line endings and removeUnusedImports) is inherited from the
				     root pom pluginManagement. Run `mvn spotless:apply` to auto-fix. -->
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<!-- Story 2.30 — the `check` execution stays bound to verify (story
				     1.21) for local dev/CI parity. failThreshold=High (inherited from
				     root pluginManagement) means `mvn verify` fails only on HIGH-
				     severity findings; MEDIUM is reported but non-failing (AC3). -->
				<executions>
					<execution>
						<id>spotbugs-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<!-- Story 2.32 — backend coverage gate. Story 1.21 seeded the
				     version pin plus the prepare-agent, prepare-agent-integration
				     and report executions in the root pluginManagement as
				     report-only plumbing. This module adds the enforcing check
				     and a merge step so the report and the gate both see unit
				     AND integration coverage combined. The two prepare-agent
				     executions are inherited unchanged and must not be edited. -->
				<configuration>
					<!-- Excluded from coverage analysis; honored by report and
					     check. DeliveryLineApplication is the @SpringBootApplication
					     bootstrap (a one-line main() delegating to
					     SpringApplication.run) with no business logic and is not
					     meaningfully unit-testable. Nothing else is excluded:
					     AC5 forbids blanket-excluding business or application
					     code, and AC10 requires new packages to auto-participate,
					     so the BUNDLE rule plus this excludes-only policy is the
					     entire scoping mechanism. infrastructure/config classes
					     are intentionally left in and absorbed by the floor. -->
					<excludes>
						<exclude>org/dradgo/DeliveryLineApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<!-- Merge the Surefire (jacoco.exec) and Failsafe
					     (jacoco-it.exec) execution data. Bound to
					     post-integration-test: runs strictly after test and
					     integration-test have written their exec files and
					     strictly before the verify-phase report and check. The
					     fileSet silently skips any include that is absent, so the
					     merge stays robust if either tier produced no exec file. -->
					<execution>
						<id>jacoco-merge</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${jacoco.merged.exec}</destFile>
						</configuration>
					</execution>
					<!-- Override the inherited jacoco-report (same id, so Maven
					     merges by id; phase verify and goal report stay
					     inherited) to read the merged exec file instead of the
					     default unit-only jacoco.exec. This also fixes a latent
					     1.21 bug: the backend-coverage-jacoco CI artifact was
					     effectively empty because report read the never-written
					     jacoco.exec in the surefire-skipped tier. -->
					<execution>
						<id>jacoco-report</id>
						<configuration>
							<dataFile>${jacoco.merged.exec}</dataFile>
						</configuration>
					</execution>
					<!-- Enforcing gate. Bound to verify; reads the merged exec
					     file. The BUNDLE-scoped rule fails the build
					     deterministically (haltOnFailure defaults to true) when
					     LINE or BRANCH coverage drops below the committed floor.
					     Floors were measured empirically against the CI shape and
					     set below it as regression headroom (see
					     deliveryline-backend/README.md). skip is wired to a
					     property so the foundation-gate profile can switch the
					     gate off without disabling prepare-agent. -->
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<dataFile>${jacoco.merged.exec}</dataFile>
							<skip>${jacoco.check.skip}</skip>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.75</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.55</minimum>
										</limit>
									</limits>
								</rule>
									<!-- Story 3.35 (AC11, OQ-1) - additive per-PACKAGE line floors for Epic-3 net-new
									     packages, on top of the BUNDLE rule (which still counts them). 0.80 is AC11's named
									     floor and sits under each package's measured line coverage on the merged
									     unit+integration run (queue 0.90, workspace 0.84, ticketsource 1.0, repohost 1.0,
									     recovery 0.98 as of 2026-06-19), guarding each against silent regression without
									     reddening the green build. PACKAGE element names are JaCoCo DOTTED form (slash form
									     silently matches nothing - verified); one rule with multiple includes applies the
									     limit to EACH matched package independently. -->
									<rule>
										<element>PACKAGE</element>
										<includes>
											<include>org.dradgo.application.runner.queue</include>
											<include>org.dradgo.application.runner.workspace</include>
											<include>org.dradgo.application.integration.ticketsource</include>
											<include>org.dradgo.application.integration.repohost</include>
											<include>org.dradgo.application.recovery</include>
											<!-- Story 3c-3 (AC9) — net-new application.project package (ProjectConnectorResolver
											     + ProjectCredentialSource seam). 0.80 named floor; ProjectConnectorResolverTest
											     measures well above it. -->
											<include>org.dradgo.application.project</include>
										</includes>
										<limits>
											<limit>
												<counter>LINE</counter>
												<value>COVEREDRATIO</value>
												<minimum>0.80</minimum>
											</limit>
										</limits>
									</rule>
									<!-- Story 3c-4 (AC7) - net-new infrastructure.crypto package (the security-gated
									     credential cipher + master-key guard). 0.90 LINE floor (credential/crypto code,
									     per 3c-11 AC5) - higher than the 0.80 floor above because this is security-gated
									     code that should self-protect the moment it lands; 3c-11 then widens coverage to
									     the rest of the credential subsystem. EnvelopeCredentialCipherTest +
									     CredentialMasterKeyGuardTest measure well above it. PACKAGE names are DOTTED. -->
									<rule>
										<element>PACKAGE</element>
										<includes>
											<include>org.dradgo.infrastructure.crypto</include>
										</includes>
										<limits>
											<limit>
												<counter>LINE</counter>
												<value>COVEREDRATIO</value>
												<minimum>0.90</minimum>
											</limit>
										</limits>
									</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Story 1.21 — Surefire (unit tests): pure JUnit5 unit tests. Excludes
			     @Tag('architecture'|'integration'|'contract'|'known-failure').
			     argLine pins UTC + UTF-8 (1.17 deferral).
			     archunit engine excluded because ArchUnitTestEngine does not honor
			     JUnit Platform tag filters — @ArchTest fields would otherwise leak
			     into Surefire despite the class-level @Tag('architecture'). The
			     same tests run under Failsafe (which keeps the archunit engine). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Duser.timezone=UTC -Dfile.encoding=UTF-8</argLine>
					<excludedGroups>architecture,integration,contract,known-failure,foundation-gate</excludedGroups>
					<!-- File-pattern exclusion mirrors Failsafe's <includes> below. Tag-based
					     exclusion (excludedGroups) only catches tests that remembered to add
					     @Tag('contract')/@Tag('integration'); many *ContractTest.java files
					     have @Import(TestcontainersConfiguration.class) + @SpringBootTest but
					     no @Tag, so they leak into Surefire and crash on Windows runners
					     (no Docker). File-pattern exclusion makes the naming convention
					     self-enforcing — adding a new *ContractTest.java automatically
					     routes it to Failsafe without needing the author to also tag it. -->
					<excludes>
						<exclude>**/*IT.java</exclude>
						<exclude>**/IT*.java</exclude>
						<exclude>**/*ITCase.java</exclude>
						<exclude>**/*ContractTest.java</exclude>
						<exclude>**/*AppendOnlyTest.java</exclude>
						<exclude>**/architecture/**/*Test.java</exclude>
						<!-- Story 1.23 — foundation-gate aggregator is excluded by the
						     `foundation-gate` tag in <excludedGroups> above; tag-based
						     exclusion is the source-of-truth invariant per Task 1, so a
						     future @Tag("foundation-gate") test placed outside the
						     foundation/ package is also kept out of the unit-test tier.
						     The supporting *FoundationContract.java helper classes do not
						     match Surefire's default include pattern (*Test.java family),
						     so they are unreachable here regardless. -->
						<!-- Spring Boot smoke "context loads" test boots the full
						     application context with @Import(TestcontainersConfiguration),
						     so it needs Docker — Failsafe (Linux-only) is the right slice. -->
						<exclude>**/*ApplicationTests.java</exclude>
					</excludes>
					<!-- Surefire JUnit Platform provider expects a comma-separated string,
					     NOT a nested <exclude> element for the engines list. Earlier nested
					     syntax was silently ignored by Maven; the archunit engine was leaking
					     into Surefire. -->
					<excludeJUnit5Engines>archunit</excludeJUnit5Engines>
				</configuration>
			</plugin>

			<!-- Story 1.21 — Failsafe (integration tier): ArchUnit + Testcontainers +
			     contract + integration. File-pattern filtering (NOT tag-group) because
			     the ArchUnit JUnit 5 engine does not propagate the class-level
			     @Tag('architecture') to its @ArchTest descriptors — a <groups> filter
			     would silently exclude them. Pattern-based discovery keeps the engine
			     reachable. <excludedGroups>known-failure</excludedGroups> tags F17
			     out symmetrically with Surefire.
			     Spring Boot starter parent already binds failsafe's integration-test +
			     verify goals to the verify phase via its default execution; we configure
			     at the plugin level so the inherited binding inherits the filter set. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Duser.timezone=UTC -Dfile.encoding=UTF-8</argLine>
					<!-- Story 3.1 — docker-runner-it is the opt-in tier for Testcontainers-backed
					     DockerRunnerAdapter ITs that pull real container images. Default-exclude it
					     so the backend-contract-tests CI job does NOT run those ITs (they need
					     image pulls that the foundation gate intentionally avoids). The dedicated
					     `docker-runner-it` profile below clears this exclusion. Story 3-8 ships
					     the real CI tier for the real Codex/Claude images. -->
					<excludedGroups>known-failure,docker-runner-it</excludedGroups>
					<includes>
						<include>**/*IT.java</include>
						<include>**/IT*.java</include>
						<include>**/*ITCase.java</include>
						<include>**/*ContractTest.java</include>
						<include>**/*AppendOnlyTest.java</include>
						<include>**/architecture/**/*Test.java</include>
						<include>**/*ApplicationTests.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Story 1.21 — `-Parch` runs ArchUnit subset standalone for AC7 triage.
		     TODO(archunit-engine-tags): the <groups>architecture</groups> filter
		     below is currently a NO-OP because ArchUnitTestEngine does not honor
		     JUnit Platform tag filters (the engine does not propagate @Tag from the
		     containing class to its @ArchTest field descriptors). Profile is kept
		     for spec compliance (Task 7) and forward compatibility once the engine
		     supports tag propagation. To run only the ArchUnit subset today, use
		     `mvn failsafe:integration-test -Dit.test='**/architecture/**/*Test'`. -->
		<profile>
			<id>arch</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<groups>architecture</groups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Story 1.23 — `-Pfoundation-gate` runs the FoundationGateVerificationTest
		     aggregator. The aggregator delegate-runs every Epic-1 contract test via the
		     JUnit Platform Launcher API; supporting *FoundationContract classes are
		     unreachable through standard Maven discovery (their names don't match any
		     include pattern) and are invoked only via the Launcher. The profile clears
		     the default `foundation-gate` exclusion (added to <excludedGroups> above)
		     and adds a <groups> filter so this tier runs ONLY the foundation-gate
		     tagged tests — the dedicated `foundation-gate` GitHub Actions job uses
		     this profile. -->
		<profile>
			<id>foundation-gate</id>
			<!-- Story 2.32 — skip ONLY the JaCoCo check in this profile. The
			     foundation-gate job runs just the FoundationGateVerificationTest
			     aggregator subset, whose coverage is not representative of the
			     module, so gating on it would red-build unpredictably.
			     prepare-agent, prepare-agent-integration, merge and report still
			     run, so Failsafe's @{argLine} stays intact (no forked-JVM
			     crash). The real coverage gate runs in the backend-contract-tests
			     CI tier, a needs: dependency of the foundation-gate job, so AC12
			     holds transitively. -->
			<properties>
				<jacoco.check.skip>true</jacoco.check.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<excludedGroups>known-failure</excludedGroups>
							<groups>foundation-gate</groups>
							<includes>
								<include>**/*IT.java</include>
								<include>**/IT*.java</include>
								<include>**/*ITCase.java</include>
								<include>**/*ContractTest.java</include>
								<include>**/*AppendOnlyTest.java</include>
								<include>**/architecture/**/*Test.java</include>
								<include>**/foundation/**/*Test.java</include>
								<include>**/*ApplicationTests.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Story 3.7 — opt-in tier for Testcontainers-backed ITs tagged `docker-runner-it`
		     (e.g. ElkPipelineRoundTripIT). The default Failsafe config excludes that tag so the
		     no-Docker PR / foundation tiers skip image pulls; this profile clears the exclusion so
		     the IT can be run locally / on a Docker-capable CI tier. Narrow to one IT with
		     `-Dit.test=ElkPipelineRoundTripIT`. Each IT also carries @EnabledIfDockerAvailable, so it
		     no-ops cleanly when no Docker engine is present. -->
		<profile>
			<id>docker-runner-it</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<excludedGroups>known-failure</excludedGroups>
							<includes>
								<include>**/*IT.java</include>
								<include>**/IT*.java</include>
								<include>**/*ITCase.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Story 3.35 (AC3, Task 2) - opt-in tier for the live-GitHub drift canary,
		     GitHubRealLiveIntegrationTest (@Tag("gh-real-tests")). NEVER run in PR CI or the
		     foundation gate (the deterministic GitHubMockVsRealParityFoundationContract is the
		     every-PR guard); the workflow_dispatch-only .github/workflows/nightly-gh-real.yml is
		     the only path that exercises the real adapter against api.github.com. Mirrors the
		     docker-runner-it profile shape but selects the tag and opens the test's
		     @EnabledIfSystemProperty(deliveryline.github.live-tests) gate by declaring the
		     property on the forked Failsafe JVM (a bare -D does NOT propagate to the fork).
		     deliveryline.github.live.repo flows through from the CLI; when unset it stays the
		     literal placeholder, which the test's assumeTrue regex rejects so the test aborts
		     cleanly. The class name ends in IntegrationTest (not *IT), so the include list is
		     widened. jacoco.check.skip=true: a single live smoke is not representative coverage. -->
		<profile>
			<id>gh-real-tests</id>
			<properties>
				<jacoco.check.skip>true</jacoco.check.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<excludedGroups>known-failure</excludedGroups>
							<groups>gh-real-tests</groups>
							<includes>
								<include>**/*IntegrationTest.java</include>
							</includes>
							<systemPropertyVariables>
								<deliveryline.github.live-tests>true</deliveryline.github.live-tests>
								<deliveryline.github.live.repo>${deliveryline.github.live.repo}</deliveryline.github.live.repo>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
