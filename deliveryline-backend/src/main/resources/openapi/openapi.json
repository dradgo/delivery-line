            "type" : "boolean"
          },
          "workflowRunId" : {
            "example" : "run_abc123",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "WorkflowEvent" : {
        "description" : "A single workflow event.",
        "properties" : {
          "actorIdentity" : {
            "minLength" : 1,
            "type" : "string"
          },
          "actorType" : {
            "enum" : [
              "human",
              "agent",
              "system",
              "service_account"
            ],
            "example" : "system",
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "details" : {
            "additionalProperties" : { },
            "description" : "Open detail map; server-only keys (e.g. idempotencyKey) are stripped. Known keys include linearTicketReference, artifactId, artifactVersion, contextVersion, correlationId, failedStage, triggeringEventId, recoveryActionId, recoveryRetriedEventId, compensationFailed, reviewerRole, taggedFeedback, specRejectionLoopCount, escalationMarker, artifactVariant, and feedback.",
            "not" : {
              "required" : [
                "idempotencyKey"
              ],
              "type" : "object"
            },
            "properties" : {
              "artifactId" : {
                "minLength" : 1,
                "type" : "string"
              },
              "artifactVariant" : {
                "enum" : [
                  "spec",
                  "implementationPlan",
                  "prOutput"
                ],
                "type" : "string"
              },
              "artifactVersion" : {
                "format" : "int32",
                "minimum" : 1,
                "type" : "integer"
              },
              "compensationFailed" : {
                "type" : "boolean"
              },
              "contextVersion" : {
                "format" : "int32",
                "minimum" : 1,
                "type" : "integer"
              },
              "correlationId" : {
                "minLength" : 1,
                "type" : "string"
              },
              "errorClass" : {
                "minLength" : 1,
                "type" : "string"
              },
              "errorCode" : {
                "minLength" : 1,
                "type" : "string"
              },
              "failedStage" : {
                "minLength" : 1,
                "type" : "string"
              },
              "feedback" : {
                "type" : "string"
              },
              "reviewerRole" : {
                "minLength" : 1,
                "type" : "string"
              },
              "taggedFeedback" : {
                "minLength" : 1,
                "type" : "string"
              },
              "specRejectionLoopCount" : {
                "format" : "int32",
                "minimum" : 0,
                "type" : "integer"
              },
              "escalationMarker" : {
                "type" : "boolean"
              },
              "linearTicketReference" : {
                "minLength" : 1,
                "type" : "string"
              },
              "reason" : {
                "type" : "string"
              },
              "recoveryActionId" : {
                "pattern" : "^rcv_[A-Za-z0-9_]{4,}$",
                "type" : "string"
              },
              "recoveryRetriedEventId" : {
                "pattern" : "^evt_[A-Za-z0-9_]{4,}$",
                "type" : "string"
              },
              "triggeringEventId" : {
                "pattern" : "^evt_[A-Za-z0-9_]{4,}$",
                "type" : "string"
              }
            },
            "type" : "object"
          },
          "eventType" : {
            "enum" : [
              "workflow.stateChanged",
              "approval.requested",
              "approval.approved",
              "approval.rejected",
              "escalation.required",
              "artifact.draftCreated",
              "artifact.available",
              "artifact.failed",
              "artifact.versionCreated",
              "runner.started",
              "runner.failed",
              "recovery.retried",
              "recovery.dispatchFailed",
              "recovery.reconciled",
              "artifact.lineageRecovered",
              "integration.linked",
              "export.created",
              "clarification.answered",
              "clarification.accepted",
              "clarification.incorporated",
              "clarification.superseded",
              "clarification.rejectedInvalid",
              "clarification.noEffectReason"
            ],
            "example" : "workflow.stateChanged",
            "type" : "string"
          },
          "failureCategory" : {
            "enum" : [
              "runner_timeout",
              "runner_crash",
              "runner_contract_violation",
              "runner_non_zero_exit",
              "runner_late_result",
              "runner_duplicate_result",
              "runner_malformed_output",
              "orphan"
            ],
            "type" : [
              "string",
              "null"
            ]
          },
          "interventionMarker" : {
            "type" : "boolean"
          },
          "priorState" : {
            "enum" : [
              "Inbox",
              "Planned",
              "Investigating",
              "WaitingForSpecApproval",
              "Executing",
              "WaitingForReview",
              "Completed",
              "Failed",
              "Paused",
              "TakenOver",
              "Reconciled"
            ],
            "type" : [
              "string",
              "null"
            ]
          },
          "publicId" : {
            "example" : "evt_abc123",
            "pattern" : "^evt_[A-Za-z0-9_]{4,}$",
            "type" : "string"
          },
          "reason" : {
            "type" : [
              "string",
              "null"
            ]
          },
          "resultingState" : {
            "enum" : [
              "Inbox",
              "Planned",
              "Investigating",
              "WaitingForSpecApproval",
              "Executing",
              "WaitingForReview",
              "Completed",
              "Failed",
              "Paused",
              "TakenOver",
              "Reconciled"
            ],
            "type" : [
              "string",
              "null"
            ]
          },
          "workflowRunPublicId" : {
            "example" : "run_abc123",
            "pattern" : "^run_[A-Za-z0-9_]{4,}$",
            "type" : "string"
          }
        },
        "required" : [
          "actorIdentity",
          "actorType",
          "createdAt",
          "details",
          "eventType",
          "interventionMarker",
          "publicId",
          "workflowRunPublicId"
        ],
        "type" : "object"
      },
      "WorkflowEventsResponse" : {
        "description" : "Ordered event history for a workflow run.",
        "properties" : {
          "events" : {
            "items" : {
              "$ref" : "#/components/schemas/WorkflowEvent"
            },
            "minItems" : 1,
            "type" : "array"
          },
