            "type" : "integer"
          },
          "title" : {
            "example" : "Workflow run not found",
            "type" : "string"
          },
          "type" : {
            "example" : "https://deliveryline.local/problems/run-not-found",
            "format" : "uri",
            "type" : "string"
          }
        },
        "required" : [
          "code",
          "detail",
          "instance",
          "retryable",
          "status",
          "title",
          "type"
        ],
        "type" : "object"
      },
