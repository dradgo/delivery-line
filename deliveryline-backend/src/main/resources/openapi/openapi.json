          },
          "currentActorType" : {
            "type" : "string"
          },
          "currentState" : {
            "example" : "WaitingForSpecApproval",
            "type" : "string"
          },
          "failedStage" : {
            "type" : "string"
          },
          "failureCategory" : {
            "type" : "string"
          },
          "failureTimestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "lastActivityTimestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "lastEventAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "lastEventType" : {
            "type" : "string"
          },
