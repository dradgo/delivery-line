{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Runner Queue",
  "uid": "deliveryline-runner-queue",
  "tags": ["deliveryline", "runner", "queue"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth over time",
      "description": "Headline metric: runner executions currently queued.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deliveryline_runner_queue_depth",
          "legendFormat": "queue depth"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest queued age (seconds)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deliveryline_runner_queue_oldest_age_seconds",
          "legendFormat": "oldest queued age (s)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Worker-pool utilization",
      "description": "Active vs idle vs pool size.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deliveryline_runner_active_workers",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deliveryline_runner_idle_workers",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deliveryline_runner_pool_size",
          "legendFormat": "pool size"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-stage throughput (completions/min)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (stage, outcome) (rate(deliveryline_runner_completed_count_total[5m])) * 60",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dispatch duration p50/p95/p99",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, stage) (rate(deliveryline_runner_dispatch_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{stage}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(deliveryline_runner_dispatch_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{stage}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(deliveryline_runner_dispatch_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{stage}}"
        }
      ]
    }
  ]
}
