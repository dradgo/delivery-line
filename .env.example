# Copy this file to .env and fill in values. Do NOT commit .env (it is in .gitignore per story 1.1 AC6).

# Linear API key for ticket intake — get one at https://linear.app/settings/api
# Host-side only (story 3.14): NEVER injected into a runner container. The KEY determines the
# Linear *workspace* that intake reads from (a workspace is not a filterable field — it IS the
# token); to read a different workspace, mint the key inside that workspace.
LINEAR_API_KEY=

# Story 3a.4 — OPTIONAL poll-scoping WITHIN the token's workspace. Absent ⇒ poll the whole
# workspace (original behavior). These are non-secret identifiers bound to the properties
# deliveryline.linear.team-key / .project-id. Set them by uncommenting those keys in
# application.yml, or via Spring relaxed-binding env vars (dashes are dropped — note the canonical
# names below have no underscore between "team"/"project" and the suffix).
# DELIVERYLINE_LINEAR_TEAMKEY=     # e.g. FIN — scope intake to one Linear team key
# DELIVERYLINE_LINEAR_PROJECTID=   # e.g. a Linear project UUID — scope intake to one project

# Story 3a.5 — OPTIONAL opt-in auto-ingest (default OFF ⇒ the poll stays a watcher). When true, the
# poll auto-creates a governed run for each ticket whose Linear ISSUE WORKFLOW-STATE ID is in the
# configured allow-list AND that has no active link. Binds to deliveryline.linear.auto-ingest.enabled
# (relaxed-binding: DELIVERYLINE_LINEAR_AUTOINGEST_ENABLED). The status-ids ALLOW-LIST is a YAML list
# (awkward via a single env var) — set it under deliveryline.linear.auto-ingest.status-ids in
# application.yml, or as indexed env entries DELIVERYLINE_LINEAR_AUTOINGEST_STATUSIDS_0=... if needed.
# An enabled flag with an EMPTY status-ids list ingests NOTHING (never the whole workspace).
# DELIVERYLINE_LINEAR_AUTOINGEST_ENABLED=false

# GitHub PAT for PR linkage — needs `repo` scope; get one at https://github.com/settings/tokens
# Host-side only (story 3.14): NEVER injected into a runner container.
GITHUB_TOKEN=

# deliveryline-bot git identity for clone/commit/push (story 3.9, Decision D8). Host-side only —
# NEVER injected into a runner container. Blank ⇒ the built-in default identity
# (DeliveryLine Bot / deliveryline-bot@dradgo.org) is used and `doctor` WARNs under github-real.
DELIVERYLINE_BOT_NAME=
DELIVERYLINE_BOT_EMAIL=

# --- Runner agent-provider API keys (story 3.5) -------------------------------------------------
# Injected into the runner container env at dispatch time (Config.Env). NEVER committed; see
# docs/adr/0003-runner-secrets-mvp-posture.md. `doctor` reports presence per runner kind.
# Codex runner (story 3.3 / 3a-3): subscription-first, first present wins (each injected under its
# own name).
# 1) Subscription mode (PREFERRED — billed against a ChatGPT/Codex Pro subscription, the cost-saving
#    path). Run `codex login` on a TRUSTED host, then minify ~/.codex/auth.json into a SINGLE LINE
#    of JSON and paste it below. The runner entrypoint materializes it to $CODEX_HOME/auth.json
#    (mode 0600) before invoking Codex. NEVER commit this value.
CODEX_AUTH_JSON=
# 2) API mode (fallback — per-token API billing). Get a key at https://platform.openai.com/api-keys.
#    CODEX_API_KEY then OPENAI_API_KEY (aliases for the same OpenAI key).
CODEX_API_KEY=
OPENAI_API_KEY=
# Claude runner (story 3.4): dual-mode auth, first present wins (each injected under its own name).
# 1) Subscription mode (PREFERRED — billed against a Claude Pro/Max subscription, the cost-saving
#    path). Generate a token with `claude setup-token` (Claude Code CLI) and paste it here:
CLAUDE_CODE_OAUTH_TOKEN=
# 2) API mode (fallback — per-token API billing). Get a key at
#    https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Base directory for runtime state — defaults to ./deliveryline-data if unset
DELIVERYLINE_HOME=

# Local PostgreSQL password for Docker Compose and Spring Boot service discovery
POSTGRES_PASSWORD=deliveryline

# Override if 5432 is in use on host (story 1.2)
POSTGRES_HOST_PORT=5432

# --- Observability / ELK stack (story 3.7) ------------------------------------------------------
# Active ONLY under the "observability" Docker Compose profile (ELK is profile-gated; the backend
# runs identically without it — AR25). `scripts/start-all.{ps1,sh}` bring the stack up. Override
# any host port below if it collides. Elasticsearch heap is tuned via ES_JAVA_OPTS (AC10); the
# `doctor` memory check WARNs when this profile is active on a host with < 8 GB RAM.
ELASTIC_HOST_PORT=9200
LOGSTASH_HOST_PORT=5044
KIBANA_HOST_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m
#
# LOGSTASH_HOST_PORT above is the *published host port* for the logstash container. It is SEPARATE
# from the destination the backend's Logstash appender dials, which is LOGSTASH_HOST:LOGSTASH_PORT
# (logback-spring.xml, observability profile; defaults localhost:5044 — matching LOGSTASH_HOST_PORT's
# default). If you remap LOGSTASH_HOST_PORT, also set LOGSTASH_PORT (and LOGSTASH_HOST when the
# backend is not co-located with logstash) so the appender targets the same endpoint.
# LOGSTASH_HOST=localhost
# LOGSTASH_PORT=5044

# Story 3.19 — Prometheus + Grafana host ports (observability profile only). Override on a port
# collision. GRAFANA_ADMIN_PASSWORD sets the Grafana admin password (anonymous Viewer access is on
# by default for the local stack, so this only matters if you log in to edit).
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
# GRAFANA_ADMIN_PASSWORD=admin
