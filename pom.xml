<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>org.dradgo</groupId>
	<artifactId>deliveryline</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>deliveryline</name>
	<description>Governed local-first agent delivery workflow</description>

	<modules>
		<module>deliveryline-backend</module>
		<module>deliveryline-frontend</module>
		<module>deliveryline-runner-contracts</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-shell.version>4.0.2</spring-shell.version>
		<frontend-maven-plugin.skip>false</frontend-maven-plugin.skip>
		<!-- Story 1.21 — quality plugin versions (centralized so modules opt in by <plugin> declaration only). -->
		<spotless-maven-plugin.version>2.46.1</spotless-maven-plugin.version>
		<google-java-format.version>1.27.0</google-java-format.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<checkstyle.version>10.21.4</checkstyle.version>
		<spotbugs-maven-plugin.version>4.9.4.2</spotbugs-maven-plugin.version>
		<jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.shell</groupId>
				<artifactId>spring-shell-dependencies</artifactId>
				<version>${spring-shell.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Story 1.21 — format-static-checks tier. Spotless / Checkstyle / SpotBugs
				     are declared here with conservative defaults; modules opt in by adding
				     a <plugin> entry without a version. -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless-maven-plugin.version}</version>
					<configuration>
						<!-- Pin LF explicitly so spotless:apply produces identical output on
						     Windows + Linux runners (and stops Windows devs from seeing ~285
						     stat-only "modified" entries after apply when core.autocrlf=true
						     re-injects CRLF on checkout). -->
						<lineEndings>UNIX</lineEndings>
						<java>
							<includes>
								<include>src/main/java/**/*.java</include>
								<include>src/test/java/**/*.java</include>
							</includes>
							<googleJavaFormat>
								<version>${google-java-format.version}</version>
								<style>GOOGLE</style>
							</googleJavaFormat>
							<removeUnusedImports/>
							<trimTrailingWhitespace/>
							<endWithNewline/>
						</java>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>${checkstyle.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<!-- Story 2.30 — committed ruleset is the source of truth (replaces the
						     JAR-bundled google_checks.xml so a Checkstyle version bump cannot
						     silently change the rules). suppressionsLocation supplies
						     ${checkstyle.suppressions.file} to the ruleset's SuppressionFilter.
						     ${maven.multiModuleProjectDirectory} resolves to the repo root under
						     mvnw (matches the resources-plugin paths in deliveryline-backend). -->
						<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
						<suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
						<sourceDirectories>
							<sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
						</sourceDirectories>
						<consoleOutput>true</consoleOutput>
						<failsOnError>true</failsOnError>
						<failOnViolation>true</failOnViolation>
						<violationSeverity>error</violationSeverity>
					</configuration>
				</plugin>

				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
					<configuration>
						<!-- Story 1.21 + 2.30 — the analysis threshold and the build-fail
						     threshold are deliberately split:
						       threshold=Medium     — what the `spotbugs` goal REPORTS: MEDIUM
						                              and HIGH findings both land in
						                              spotbugsXml.xml / spotbugs.html (the CI
						                              artifact), so MEDIUM stays visible.
						       failThreshold=High   — what the `check` goal FAILS the build on:
						                              HIGH-severity findings only (AC3). MEDIUM
						                              is reported but non-failing until a
						                              deferred story escalates it.
						     failOnError=true is required for the `check` goal to gate the
						     build at all — with it false `check` reports findings but never
						     fails (verified empirically in story 2.30). effort=Max for the
						     deepest analysis. -->
						<effort>Max</effort>
						<threshold>Medium</threshold>
						<failThreshold>High</failThreshold>
						<failOnError>true</failOnError>
						<xmlOutput>true</xmlOutput>
						<htmlOutput>true</htmlOutput>
					</configuration>
				</plugin>

				<!-- Story 1.21 — coverage artifact only. No threshold gate here; story 2.32
				     wires the gate per epics.md:1028. -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco-maven-plugin.version}</version>
					<executions>
						<execution>
							<id>jacoco-prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-prepare-agent-integration</id>
							<goals>
								<goal>prepare-agent-integration</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
