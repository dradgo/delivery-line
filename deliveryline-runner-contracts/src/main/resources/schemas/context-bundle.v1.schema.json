{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deliveryline.local/runner-contracts/context-bundle.v1.schema.json",
  "title": "DeliveryLine Context Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowRunId",
    "runnerExecutionId",
    "ticketSummary",
    "approvedSpecificationReference",
    "priorFeedbackReferences",
    "artifactReferences",
    "executionConstraints",
    "classification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowRunId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{4,64}$"
    },
    "runnerExecutionId": {
      "type": "string",
      "pattern": "^rex_[A-Za-z0-9_-]{4,64}$"
    },
    "ticketSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticketRef",
        "title",
        "summary"
      ],
      "properties": {
        "ticketRef": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approvedSpecificationReference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifactReference"
        }
      ]
    },
    "priorFeedbackReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceId",
          "kind"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactReferences": {
      "type": "array",
      "minItems": 0,
      "description": "Spec-investigation bundles legitimately carry zero artifact references when no spec has been generated yet (story 2.8 AC3); minItems relaxed from 1 to 0 in-place as a backward-compatible v1 patch (existing producers always passed >=1; consumers must already accept 0+).",
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "executionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutSeconds",
        "allowRawOutput"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "allowRawOutput": {
          "type": "boolean"
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "local-only",
        "shareable-redacted",
        "shareable-full",
        "derived-public-safe"
      ]
    },
    "repositoryWorkspaceRef": {
      "type": "string",
      "pattern": "^/workspace/repo$",
      "description": "Story 3a-2 (AC1) — OPTIONAL. The deterministic container mount path the runner reads the cloned working tree from. Emitted by the spec-investigation bundle ONLY when a repository workspace was prepared for the run; absent (with the four sibling repo fields) for every no-repo and execution-stage bundle, which therefore stay byte-identical to the story-2.8 baseline. Additive backward-compatible v1 patch (NOT in required; mirrors the minItems 1->0 precedent above); schemaVersion stays const:1."
    },
    "repositoryTreeSummary": {
      "type": "array",
      "description": "Story 3a-2 (AC1) — OPTIONAL, redacted. Depth-limited top-level tree listing of the cloned working tree (.gitignore-respecting, entry-capped). Embedded content; redacted by the single shareable-redacted pass.",
      "items": {
        "$ref": "#/$defs/repoTreeEntry"
      }
    },
    "repositoryReadmeRef": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Story 3a-2 (AC1) — OPTIONAL. Mount-relative path to the detected README (reference-by-path, Decision D4), or null when none exists. Never a host absolute path (Trap T7)."
    },
    "packageManifestRefs": {
      "type": "array",
      "description": "Story 3a-2 (AC1) — OPTIONAL. Mount-relative references to detected package/build manifests (package.json / pom.xml / Cargo.toml / build.gradle / go.mod / requirements.txt / pyproject.toml). Reference-by-path, not embedded bodies (Decision D4).",
      "items": {
        "$ref": "#/$defs/repoManifestRef"
      }
    },
    "ticketRepositoryMappingVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Story 3a-2 (AC1, Decision D2) — OPTIONAL. Marker for which Linear<->GitHub mapping resolved to this repo. Config-derived for the pilot (e.g. config:<repoKey>@1); a real mapping version is deferred to stories 3.32/3.33."
    }
  },
  "$defs": {
    "repoTreeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "file",
            "dir"
          ]
        }
      }
    },
    "repoManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactType",
        "referencePath",
        "artifactStatus",
        "referenceAvailable",
        "unavailableReason"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]{4,64}$"
        },
        "artifactType": {
          "type": "string",
          "enum": [
            "spec",
            "implementationPlan",
            "prOutput"
          ]
        },
        "artifactStatus": {
          "type": "string",
          "enum": [
            "pending",
            "available",
            "failed",
            "late_or_stale"
          ]
        },
        "referenceAvailable": {
          "type": "boolean"
        },
        "referencePath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
