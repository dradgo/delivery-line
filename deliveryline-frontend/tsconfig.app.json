{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias (story 2.2 — shadcn/ui requires `@/*`). This SUPERSEDES story
       2.1's note deferring aliases to 2.5/2.6: shadcn mandates `@/*`, so it is
       introduced here. Mirror this in vite.config.ts `resolve.alias`.
       No `baseUrl` — it is deprecated in TS 6.0; with moduleResolution "bundler"
       the `paths` entries resolve relative to this tsconfig's directory. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Strict mode (AC5 — story 2.1) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"]
}
