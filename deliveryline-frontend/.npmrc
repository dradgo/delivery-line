# Story 2.6 — peer-dependency resolution policy.
#
# This module pins TypeScript ~6.0 (tsconfig strict + Vite 8 toolchain), but a
# number of TS-consuming devtools still declare `peerDependencies: typescript@^5`
# (e.g. openapi-typescript@7), which npm 10's strict peer resolver rejects with
# ERESOLVE. TS 6.0 is backward-compatible for these tools' purposes (they parse
# the compiler API surface they need), so we accept the looser resolution rather
# than hold the whole toolchain back to TS 5.
#
# Committed (NOT gitignored) so `npm install` (lockfile authoring) and CI's
# `npm ci` resolve the dependency tree IDENTICALLY — without this file the two
# diverge and the cross-platform lockfile discipline breaks.
legacy-peer-deps=true
